<?xml version="1.0" encoding="UTF-8"?>
<!--
  brXM Discovery Plugin - Site assembly
  ======================================
  Loaded via classpath:META-INF/hst-assembly/addon/ into a dedicated addon child ApplicationContext.
  Beans are accessible via HstServices.getComponentManager().getComponent(Class, MODULE_NAME)
  where MODULE_NAME = "org.bloomreach.forge.discovery.site".
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans-4.3.xsd">

    <!-- Config: delegates to CMS-registered provider or starts a local fallback -->

    <bean id="brxmdis.configReader"
          class="org.bloomreach.forge.discovery.config.DiscoveryConfigReader"/>

    <bean id="brxmdis.configProvider"
          class="org.bloomreach.forge.discovery.site.config.DiscoveryConfigProviderBridge"
          init-method="start"
          destroy-method="close">
        <constructor-arg ref="brxmdis.configReader"/>
    </bean>

    <!-- Transport: shared HTTP/2 client with virtual-thread executor -->

    <bean id="brxmdis.httpClient"
          class="org.bloomreach.forge.discovery.transport.DiscoveryHttpClientFactory"
          factory-method="create"/>

    <bean id="brxmdis.transport"
          class="org.bloomreach.forge.discovery.transport.HttpClientDiscoveryTransport">
        <constructor-arg ref="brxmdis.httpClient"/>
    </bean>

    <!-- Internal helpers -->

    <bean id="brxmdis.requestFactory"
          class="org.bloomreach.forge.discovery.request.DiscoveryRequestFactory"/>

    <bean id="brxmdis.objectMapper" class="com.fasterxml.jackson.databind.ObjectMapper"/>

    <!-- Domain mappers -->

    <bean id="brxmdis.searchResponseMapper"
          class="org.bloomreach.forge.discovery.site.service.discovery.search.SearchResponseMapper">
        <constructor-arg ref="brxmdis.objectMapper"/>
    </bean>

    <bean id="brxmdis.autosuggestResponseMapper"
          class="org.bloomreach.forge.discovery.site.service.discovery.autosuggest.AutosuggestResponseMapper">
        <constructor-arg ref="brxmdis.objectMapper"/>
    </bean>

    <bean id="brxmdis.recommendationResponseMapper"
          class="org.bloomreach.forge.discovery.site.service.discovery.recommendation.RecommendationResponseMapper">
        <constructor-arg ref="brxmdis.objectMapper"/>
    </bean>

    <!-- Domain API clients -->

    <bean id="brxmdis.searchApiClient"
          class="org.bloomreach.forge.discovery.site.service.discovery.search.SearchApiClientImpl"
          lazy-init="true">
        <constructor-arg ref="brxmdis.transport"/>
        <constructor-arg ref="brxmdis.configProvider"/>
        <constructor-arg ref="brxmdis.searchResponseMapper"/>
        <constructor-arg ref="brxmdis.requestFactory"/>
    </bean>

    <bean id="brxmdis.autosuggestApiClient"
          class="org.bloomreach.forge.discovery.site.service.discovery.autosuggest.AutosuggestApiClientImpl"
          lazy-init="true">
        <constructor-arg ref="brxmdis.transport"/>
        <constructor-arg ref="brxmdis.configProvider"/>
        <constructor-arg ref="brxmdis.autosuggestResponseMapper"/>
        <constructor-arg ref="brxmdis.requestFactory"/>
    </bean>

    <bean id="brxmdis.recommendationApiClient"
          class="org.bloomreach.forge.discovery.site.service.discovery.recommendation.RecommendationApiClientImpl"
          lazy-init="true">
        <constructor-arg ref="brxmdis.transport"/>
        <constructor-arg ref="brxmdis.configProvider"/>
        <constructor-arg ref="brxmdis.recommendationResponseMapper"/>
        <constructor-arg ref="brxmdis.requestFactory"/>
    </bean>

    <!-- Pixel rate limiter: caps outbound pixel requests to Discovery at N/s per JVM node.
         Tune brxdis.pixelRatePerSecond via system property or override the constructor-arg value. -->
    <bean id="brxmdis.pixelRateLimiter"
          class="org.bloomreach.forge.discovery.site.service.discovery.pixel.PixelRateLimiter"
          destroy-method="close">
        <constructor-arg value="#{systemProperties.getOrDefault('brxdis.pixelRatePerSecond', '100')}"/>
    </bean>

    <bean id="brxmdis.pixelClientTransport"
          class="org.bloomreach.forge.discovery.site.service.discovery.DefaultDiscoveryPixelTransport"
          lazy-init="true">
        <constructor-arg ref="brxmdis.transport"/>
        <constructor-arg ref="brxmdis.configProvider"/>
        <constructor-arg ref="brxmdis.pixelRateLimiter"/>
    </bean>

    <!-- Public services - bean IDs match Class.getName() for getComponent() lookups -->

    <bean id="brxmdis.discoveryClient"
          class="org.bloomreach.forge.discovery.site.service.discovery.DiscoveryClientImpl"
          lazy-init="true">
        <constructor-arg ref="brxmdis.searchApiClient"/>
        <constructor-arg ref="brxmdis.autosuggestApiClient"/>
        <constructor-arg ref="brxmdis.recommendationApiClient"/>
        <constructor-arg ref="brxmdis.pixelClientTransport"/>
    </bean>

    <bean id="brxmdis.pixelExecutor"
          class="org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor">
        <property name="corePoolSize" value="2"/>
        <property name="maxPoolSize" value="4"/>
        <property name="queueCapacity" value="256"/>
        <property name="threadNamePrefix" value="brxdis-pixel-"/>
        <property name="rejectedExecutionHandler">
            <bean class="java.util.concurrent.ThreadPoolExecutor$DiscardOldestPolicy"/>
        </property>
    </bean>

    <bean id="brxmdis.pixelService"
          class="org.bloomreach.forge.discovery.site.service.discovery.pixel.DiscoveryPixelServiceImpl"
          lazy-init="true">
        <constructor-arg ref="brxmdis.discoveryClient"/>
        <constructor-arg ref="brxmdis.pixelExecutor"/>
    </bean>

    <bean id="brxmdis.runtimeContextFactory"
          class="org.bloomreach.forge.discovery.site.platform.DiscoveryRuntimeContextFactory"
          lazy-init="true">
        <constructor-arg ref="brxmdis.configProvider"/>
        <constructor-arg ref="org.bloomreach.forge.discovery.site.platform.DiscoveryBrUid2Service"/>
    </bean>

    <bean id="org.bloomreach.forge.discovery.site.platform.DiscoveryBrUid2Service"
          class="org.bloomreach.forge.discovery.site.platform.DiscoveryBrUid2Service"
          lazy-init="true"/>

    <bean id="org.bloomreach.forge.discovery.site.platform.CategoryPreviewCache"
          class="org.bloomreach.forge.discovery.site.platform.CategoryPreviewCache"
          lazy-init="true"/>

    <!--
      Optional SPI beans — register these in your own site assembly to activate:
        brxmdis.pixelConsentProvider  (PixelConsentProvider) — custom consent resolution (complex CMPs)
        brxmdis.sorEnrichmentProvider (SoREnrichmentProvider) — system-of-record product enrichment
    -->

    <bean id="org.bloomreach.forge.discovery.site.platform.HstDiscoveryService"
          class="org.bloomreach.forge.discovery.site.platform.HstDiscoveryService"
          lazy-init="true">
        <constructor-arg ref="brxmdis.discoveryClient"/>
        <constructor-arg ref="brxmdis.runtimeContextFactory"/>
        <constructor-arg ref="brxmdis.pixelService"/>
        <constructor-arg><null/></constructor-arg> <!-- SoREnrichmentProvider: override with brxmdis.sorEnrichmentProvider -->
        <constructor-arg><null/></constructor-arg> <!-- PixelConsentProvider: override with brxmdis.pixelConsentProvider -->
    </bean>

    <!-- Delivery REST: visual search proxy -->

    <bean id="brxmdis.multipartHttpClient"
          class="org.bloomreach.forge.discovery.rest.transport.DiscoveryMultipartHttpClientImpl">
        <constructor-arg ref="brxmdis.httpClient"/>
    </bean>

    <bean id="brxmdis.visualSearchResource"
          class="org.bloomreach.forge.discovery.site.rest.visual.DiscoveryVisualSearchResource">
        <constructor-arg ref="brxmdis.configProvider"/>
        <constructor-arg ref="brxmdis.multipartHttpClient"/>
        <constructor-arg ref="brxmdis.objectMapper"/>
    </bean>

    <!-- HST pipeline valve: routes /_brxdis-api/** to DiscoveryVisualSearchResource -->
    <bean id="brxmdis.visualSearchServiceValve"
          class="org.hippoecm.hst.core.container.JaxrsRestServiceValve"
          init-method="initialize" destroy-method="destroy">
        <constructor-arg>
            <bean class="org.hippoecm.hst.jaxrs.cxf.CXFJaxrsService">
                <constructor-arg value="brxmdisVisualSearchService"/>
                <property name="servletPath" value=""/>
                <property name="jaxrsServerFactoryBean">
                    <bean class="org.apache.cxf.jaxrs.JAXRSServerFactoryBean">
                        <property name="address" value="/"/>
                        <property name="providers">
                            <list>
                                <bean class="com.fasterxml.jackson.jakarta.rs.json.JacksonJsonProvider"/>
                                <bean class="org.bloomreach.forge.discovery.rest.mapper.DiscoveryExceptionMapper"/>
                            </list>
                        </property>
                        <property name="resourceProviders">
                            <list>
                                <bean class="org.apache.cxf.jaxrs.lifecycle.SingletonResourceProvider">
                                    <constructor-arg ref="brxmdis.visualSearchResource"/>
                                </bean>
                            </list>
                        </property>
                    </bean>
                </property>
            </bean>
        </constructor-arg>
        <property name="valveName" value="brxmdis.visualSearchServiceValve"/>
    </bean>

    <!-- Register BrxdisVisualSearchPipeline into the parent context's Pipelines map -->
    <bean class="org.hippoecm.hst.site.container.TypeDeterminedMethodInvokingFactoryBean">
        <constructor-arg value="org.hippoecm.hst.core.container.Pipeline"/>
        <property name="targetObject">
            <bean class="org.springframework.beans.factory.config.PropertyPathFactoryBean">
                <property name="targetObject" ref="org.hippoecm.hst.core.container.Pipelines"/>
                <property name="propertyPath" value="pipelines"/>
            </bean>
        </property>
        <property name="targetMethod" value="put"/>
        <property name="arguments">
            <list>
                <value>BrxdisVisualSearchPipeline</value>
                <bean class="org.hippoecm.hst.core.container.HstSitePipeline">
                    <property name="initializationValves">
                        <list>
                            <ref bean="initializationValve"/>
                        </list>
                    </property>
                    <property name="processingValves">
                        <list>
                            <ref bean="pageInfoRenderingValve"/>
                            <ref bean="brxmdis.visualSearchServiceValve"/>
                        </list>
                    </property>
                    <property name="cleanupValves">
                        <list>
                            <ref bean="cleanupValve"/>
                        </list>
                    </property>
                </bean>
            </list>
        </property>
    </bean>

</beans>
